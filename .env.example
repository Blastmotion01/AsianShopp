# ─── Database ────────────────────────────────────────────────
# Any PostgreSQL 14+ database. For local development without installing
# PostgreSQL run `npm run db:local` (embedded PostgreSQL on port 5433).
DATABASE_URL="postgresql://asiashop:asiashop@localhost:5433/asiashop?schema=public"
# Direct (non-pooled) connection for migrations. Locally: same as DATABASE_URL.
# On Vercel + Neon this is set automatically.
DATABASE_URL_UNPOOLED="postgresql://asiashop:asiashop@localhost:5433/asiashop?schema=public"

# ─── Auth ────────────────────────────────────────────────────
# Random string, at least 32 chars. Used to sign the guest cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Storage ─────────────────────────────────────────────────
# local | vercel-blob. Leave empty to auto-select: vercel-blob when BLOB_READ_WRITE_TOKEN is set, else local.
STORAGE_PROVIDER=""
# Set automatically by Vercel when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=""
# Public base URL of uploaded files. For local storage keep "/uploads".
STORAGE_URL="/uploads"
# Directory for local uploads (relative to project root)
STORAGE_LOCAL_DIR="storage/uploads"

# ─── Payments ────────────────────────────────────────────────
# mock | liqpay | wayforpay | monobank | novapay | stripe (only "mock" is implemented now)
PAYMENT_PROVIDER="mock"

# ─── Notifications ───────────────────────────────────────────
# console (logs emails/SMS to server console). Email/Telegram providers can be added later.
NOTIFIER="console"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── Seed admin (used by `npm run db:seed` and `npm run admin:create`) ───
ADMIN_EMAIL="admin@asiashop.local"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"
